<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health Connect is read on this phone only. Nothing leaves the device except what you explicitly export or push below."
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/grantButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Grant Health Connect access" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date range"
            android:paddingTop="12dp" />

        <Spinner
            android:id="@+id/rangeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/export_ranges" />

        <Button
            android:id="@+id/exportCsvButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2a. Save Activity.csv + Vitals.csv" />

        <Button
            android:id="@+id/pushButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2b. Push straight to the tracker" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
