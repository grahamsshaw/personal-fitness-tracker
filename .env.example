# ===================================================================
#  Personal Fitness Tracker - example environment file
#
#  Copy to `.env` and fill in real values.
#  On the Raspberry Pi the real `.env` already exists and is NOT overwritten
#  by deploy-to-pi.bat (it holds your Mywellness credentials).
# ===================================================================

# --- Flask ---
# Random string used to sign session cookies. Change it.
SECRET_KEY=change-me-to-a-random-string

# "1" enables Flask debug mode + auto-reloader (local dev only).
# The Dockerfile forces this off inside the container.
FITNESS_DEBUG=1

# Host port the app is published on. Change if another container
# already uses 5000 on the Pi.
FITNESS_HOST_PORT=5000

# --- Technogym / Mywellness API (live import) ---
MYWELLNESS_EMAIL=your@email.com
MYWELLNESS_PASSWORD=yourpassword

# --- Wii Fit Plus save files ---
# Path to the folder containing FitPlus*.dat files.
# Windows dev PC (NVIDIA Shield Pro over SMB):
#   \\192.168.0.57\internal\Android\data\org.dolphinemu.dolphinemu\files\Wii\title\00010004\52465050\data
# Raspberry Pi (mount the share first, e.g. at /mnt/shield):
#   /mnt/shield/Wii/title/00010004/52465050/data
# Leave blank to fall back to the local data/wii_fit folder.
WII_FIT_SOURCE_PATH=

# --- Database ---
# Defaults to sqlite:///<project>/data/fitness.db when unset.
# DATABASE_URL=sqlite:////app/data/fitness.db
