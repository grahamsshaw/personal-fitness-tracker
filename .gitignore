# Secrets
.env

# Data (database, imported files, backups) - root folder only.
# NOTE: fitness_app/static/map-data (shipped map geometry) must NOT match
# any exclude: bsdtar matches --exclude patterns against nested path
# components too, so a bare "data" exclude silently stripped it from
# deploys. The folder is deliberately not named "data". See DEPLOYMENT.md.
/data/
backups/
*.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Flask
instance/

# Logs
log/

# Local-only development files
debug/
Archive/
Resources_Archive/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Android (companion app)
companion-app/.gradle/
companion-app/.idea/
companion-app/build/
companion-app/app/build/
companion-app/local.properties
*.apk
*.aab
